# Copy this file to .env.local and fill in YOUR OWN values.
# NEVER commit .env.local. NEVER put the service_role key here or anywhere in frontend code.

# Supabase project URL — Project Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase ANON (public) key ONLY — Project Settings > API > anon public
# This key is safe to expose in a browser bundle because all access is
# gated by Row Level Security policies defined in supabase/migrations.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Email used to seed the first administrator account (see README "First Admin Setup").
# This is only used by the one-time SQL you run yourself in the Supabase SQL editor —
# it is not read by the app at runtime.
VITE_ADMIN_EMAIL=you@example.com
